# === Cloud LLM keys ===
GROQ_API_KEY=
OPENAI_API_KEY=

# === Local (Ollama) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=gemma3:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# === Cloud models ===
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
OPENAI_JUDGE_MODEL=gpt-4o-mini

# === Service URLs (for DeepEval to hit) ===
ECOMMERCE_API_URL=http://localhost:4000
RAG_API_URL=http://localhost:8000

# === DeepEval mode: "local" or "cloud" ===
DEEPEVAL_MODE=cloud
